{
  "name": "@sekereagle/worker",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "build": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json && node ../../scripts/compute/build-agent.mjs",
    "typecheck": "node ../../node_modules/typescript-native/bin/tsc -p tsconfig.json --noEmit --moduleResolution bundler --module preserve",
    "test": "node --require ts-node/register --test src/**/*.test.ts",
    "start": "node dist/main.js",
    "pretest": "npm --prefix ../.. run build --workspace @sekereagle/library-core && npm --prefix ../.. run build --workspace @sekereagle/photo-render-core && npm run build --workspace @sekereagle/media-core && npm --prefix ../.. run build --workspace @sekereagle/library-persistence",
    "test:leases": "node --require ts-node/register --experimental-test-coverage --test-coverage-include=src/tag-build-lease.ts --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 --test src/tag-build-lease.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@nestjs/common": "12.3.2",
    "@prisma/client": "7.10.1",
    "@sekereagle/config": "*",
    "@sekereagle/eagle-filter-core": "*",
    "@sekereagle/library-core": "*",
    "@sekereagle/library-persistence": "*",
    "@sekereagle/media-core": "*",
    "@sekereagle/photo-render-core": "*",
    "@sekereagle/vector-core": "*",
    "exifr": "^7.1.3",
    "pg": "^8.23.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "esbuild": "0.25.12",
    "ts-node": "^10.9.2",
    "typescript": "7.0.2"
  }
}
