{
  "name": "@sekereagle/worker",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --require ts-node/register --test src/**/*.test.ts",
    "start": "node dist/main.js",
    "pretest": "npm --prefix ../.. run build --workspace @sekereagle/library-core && true && npm run build --workspace @sekereagle/media-core",
    "test:leases": "node --require ts-node/register --experimental-test-coverage --test-coverage-include=src/tag-build-lease.ts --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 --test src/tag-build-lease.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@nestjs/common": "^11.1.29",
    "@prisma/client": "6.19.3",
    "@sekereagle/config": "*",
    "@sekereagle/vector-core": "*",
    "exifr": "^7.1.3",
    "pg": "^8.23.0",
    "sharp": "^0.35.3",
    "@sekereagle/library-core": "*",
    "@sekereagle/media-core": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
