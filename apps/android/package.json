{
  "name": "@sekereagle/android",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/gradle.mjs assembleDebug",
    "typecheck": "node scripts/gradle.mjs compileDebugKotlin compileDebugJavaWithJavac",
    "test": "node --test scripts/native-boundary.test.mjs && node scripts/gradle.mjs testDebugUnitTest",
    "lint": "node scripts/gradle.mjs lintDebug",
    "test:device": "node scripts/gradle.mjs connectedDebugAndroidTest",
    "install:device": "node scripts/gradle.mjs installDebug",
    "test:coverage": "node scripts/gradle.mjs verifyCoreCoverage"
  }
}
