{
  "name": "@sekereagle/api",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "build:openapi": "nest build --path tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "bootstrap:admin": "node dist/bootstrap-admin.js",
    "maintenance:reclassify-small-imported-tags": "node dist/maintenance/reclassify-small-imported-manual-tags.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm --prefix ../.. run build --workspace @sekereagle/config",
    "test": "node --require ts-node/register --test src/**/*.test.ts src/*/**/*.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "openapi:generate": "npm run build && node dist/openapi.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@nestjs/common": "^11.1.29",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.29",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.29",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "6.19.3",
    "@sekereagle/config": "*",
    "@sekereagle/eagle-filter-core": "*",
    "@sekereagle/vector-core": "*",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "pinyin-pro": "^3.29.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@nestjs/testing": "^11.1.21",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "prisma": "6.19.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
