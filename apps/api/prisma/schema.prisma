  latitude Float
  longitude Float
  source String @default("INFERRED")
  precision String @default("CITY")
  accuracyMeters Float?
  suggestionId String
  rowVersion Int @default(1)
  updatedAt DateTime @updatedAt
  asset EagleAsset @relation(fields:[ownerId,libraryMode,assetId],references:[ownerId,libraryMode,id],onDelete:Cascade)
  @@unique([ownerId,libraryMode,assetId])
  @@index([ownerId,libraryMode,cityId])
