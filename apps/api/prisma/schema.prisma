  ownerId String
  libraryMode LibraryMode @default(PHOTO)
  kind String
  status String @default("OPEN")
  scope Json
  createdAt DateTime @default(now())
  expiresAt DateTime?
  title String?
  rationale String?
  suggestions EaglePhotoAgentSuggestion[]
  events EaglePhotoAgentEvent[]
  @@unique([ownerId, libraryMode, id])
  @@unique([ownerId, libraryMode, number])
  @@index([ownerId, libraryMode, createdAt, id])
}

model EaglePhotoAgentEvent {
  id String @id @default(uuid())
  ownerId String
  libraryMode LibraryMode @default(PHOTO)
  taskId String
  suggestionId String?
  assetId String?
  actor String
  action String
  details Json
  createdAt DateTime @default(now())
  task EaglePhotoAgentTask @relation(fields:[ownerId,libraryMode,taskId],references:[ownerId,libraryMode,id],onDelete:Restrict)
  @@index([ownerId,libraryMode,taskId,createdAt,id])
}

model EaglePhotoAgentSuggestion {
  number Int @default(dbgenerated())
  reviewBasis String @default("VISUAL")
  id String @id @default(uuid())
  ownerId String
  libraryMode LibraryMode @default(PHOTO)
  taskId String
  assetId String
  assetRevision Int
  assetRowVersion Int
  kind String
  value Json
  evidence Json
  rationale String
  status String @default("PENDING")
  operation Json?
  createdAt DateTime @default(now())
  reviewedAt DateTime?
