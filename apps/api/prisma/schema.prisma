  @@unique([ownerId, libraryMode, sourceKey])
}

model EaglePhotoGroupMember {
  ownerId String
  libraryMode LibraryMode @default(PHOTO)
  groupId String
  assetId String
  group EaglePhotoGroup @relation(fields: [ownerId, libraryMode, groupId], references: [ownerId, libraryMode, id], onDelete: Cascade)
  asset EagleAsset @relation(fields: [ownerId, libraryMode, assetId], references: [ownerId, libraryMode, id], onDelete: Cascade)
  @@id([groupId, assetId])
  @@index([ownerId, libraryMode, assetId])
}

// Independent of asset/user cascades: deletion intent survives removing its source rows.
model EagleObjectDeletion {
  id           String      @id @default(uuid())
  ownerId      String
  libraryMode  LibraryMode
  objectKeys   String[]
  prefixes     String[]
  status       String      @default("PENDING")
  attempts     Int         @default(0)
  leaseVersion Int         @default(0)
  lockedAt     DateTime?
  availableAt  DateTime    @default(now())
  lastError    String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status, availableAt])
}

model EagleAssetEditRecipe {
  assetId String @id
  ownerId String
  libraryMode LibraryMode
  assetRevision Int
  baseAssetId String?
  baseMediaRevision Int
  recipe Json
  updatedAt DateTime @updatedAt
  asset EagleAsset @relation(fields:[ownerId,libraryMode,assetId],references:[ownerId,libraryMode,id],onDelete:Cascade)
  @@unique([ownerId,libraryMode,assetId])
  @@index([ownerId,libraryMode,baseAssetId])
}

model EaglePhotoAgentPreference {
  ownerId String
  libraryMode LibraryMode @default(PHOTO)
  instructions String @default("")
  revision Int @default(1)
  updatedAt DateTime @updatedAt
  owner User @relation(fields:[ownerId],references:[id],onDelete:Cascade)
  @@id([ownerId,libraryMode])
}

model EaglePhotoAgentTask {
  number Int @default(dbgenerated())
