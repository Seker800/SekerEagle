// Only active snapshots are read. Pending builds preserve the previous usable snapshot.
model EagleSmartFolderSemanticSnapshot {
  id           String                          @id @default(uuid())
  ownerId      String
  libraryMode  LibraryMode
  folderId     String
  intentKey    String
  text         String
  breadth      String
  threshold    Float
  spaceId      String
  queryVector  Unsupported("vector(1024)")?
  status       String                          @default("PENDING")
  isActive     Boolean                         @default(false)
  cursor       String                          @default("")
  scannedCount Int                             @default(0)
  attempts     Int                             @default(0)
  leaseToken   String?
  lockedUntil  DateTime?
  availableAt  DateTime                        @default(now())
  errorCode    String?
  completedAt  DateTime?
  createdAt    DateTime                        @default(now())
  updatedAt    DateTime                        @updatedAt
  folder       EagleSmartFolder                @relation(fields: [ownerId, libraryMode, folderId], references: [ownerId, libraryMode, id], onDelete: Cascade)
  matches      EagleSmartFolderSemanticMatch[]

  @@unique([ownerId, libraryMode, id])
  @@unique([ownerId, libraryMode, folderId, intentKey])
  @@index([status, availableAt, lockedUntil])
  @@index([ownerId, libraryMode, folderId, isActive])
}

model EagleSmartFolderSemanticMatch {
  ownerId     String
  libraryMode LibraryMode
  snapshotId  String
  embeddingId String
  similarity  Float
  snapshot    EagleSmartFolderSemanticSnapshot @relation(fields: [ownerId, libraryMode, snapshotId], references: [ownerId, libraryMode, id], onDelete: Cascade)
  embedding   EagleAssetEmbedding              @relation(fields: [ownerId, libraryMode, embeddingId], references: [ownerId, libraryMode, id], onDelete: Cascade)

  @@id([snapshotId, embeddingId])
  @@index([ownerId, libraryMode, embeddingId])
  @@index([ownerId, libraryMode, snapshotId, similarity, embeddingId])
}

model EaglePhotoMapState {
  ownerId            String
  libraryMode        LibraryMode             @default(PHOTO)
  requestedVersion   Int                     @default(1)
  visibilityVersion  Int                     @default(0)
  builtVersion       Int                     @default(0)
  dirtyAt            DateTime?               @default(now())
  availableAt        DateTime                @default(now())
  activeSnapshotId   String?
  buildingSnapshotId String?
  nextLevel          Int                     @default(0)
  leaseToken         String?
  lockedUntil        DateTime?
  attempts           Int                     @default(0)
  lastError          String?
  owner              User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  snapshots          EaglePhotoMapSnapshot[]

  @@id([ownerId, libraryMode])
  @@index([availableAt, lockedUntil])
}

model EaglePhotoMapSnapshot {
  id                String               @id @default(uuid())
