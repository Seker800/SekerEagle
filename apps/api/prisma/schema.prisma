generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LibraryMode {
  MATERIAL
  PHOTO
}

enum UserRole {
  USER
  ADMIN
}

enum UploadKind {
  EAGLE_ASSET
}

enum UploadSessionStatus {
  INITIATED
  ASSEMBLED
  FINALIZING
  COMPLETED
  FAILED
  ABORTED
}

enum EagleAssetLifecycleStatus {
  PROCESSING
  READY
  FAILED
}

enum EagleRenditionKind {
  THUMBNAIL
  PREVIEW
  POSTER
}

enum EagleRenditionStatus {
  PENDING
  READY
  FAILED
}

enum EagleAiAnalysisStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SUPERSEDED
}

enum EagleAiTagStatus {
  ACTIVE
  HIDDEN
  REJECTED
}

enum EagleMediaJobKind {
  RENDER_EDITED_COPY
  ANALYZE_PHOTO_FACES
  GENERATE_RENDITIONS
  GENERATE_THUMBNAIL
  GENERATE_PREVIEW
  PROBE_MEDIA
  EXTRACT_COLOR_PALETTE
  GENERATE_IMAGE_PYRAMID
  GENERATE_EMBEDDING
  GENERATE_AI_TAGS
  PURGE_ASSET
}

enum EagleEmbeddingStatus {
  PENDING
  RUNNING
  READY
  FAILED
  SUPERSEDED
}

enum EagleTagPrototypeStatus {
  BUILDING
  ACTIVE
  FAILED
  SUPERSEDED
}

enum EagleVectorSuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum EagleTagSemanticBuildStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum EagleImagePyramidStatus {
  PENDING
  RUNNING
  READY
  FAILED
}

enum EagleMediaJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum EagleProcessingLane {
  INTERACTIVE
  BACKGROUND
  MAINTENANCE
}

enum EagleColorAnalysisStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum EagleExternalProvider {
  EAGLE_APP
}

enum EagleImportRunStatus {
  DRAFT
  PREFLIGHTED
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum EagleImportItemStatus {
  STAGED
  UPLOADING
  FINALIZING
  IMPORTED
  SKIPPED
  FAILED
  CANCELLED
}

enum EagleImportItemAction {
  NEW
  UNCHANGED
  METADATA_UPDATE
  CONTENT_REPLACE
  SKIP_DELETED
  SKIP_UNSUPPORTED
}

model EagleLibraryTransfer {
  id String @id
  ownerId String
  sourceMode LibraryMode
  targetMode LibraryMode
  sourceIds String[]
  plan Json
  status String @default("PENDING")
  result Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  @@index([status, updatedAt])
  @@index([ownerId, sourceMode, status, updatedAt])
}

model EagleAssetOperation {
  id String @id
  ownerId String
  libraryMode LibraryMode
  kind String
  inputIds String[]
  authVersion Int
  privateUntil DateTime?
  isPrivate Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items EagleAssetOperationItem[]
  @@unique([ownerId, libraryMode, id])
  @@index([ownerId, libraryMode, createdAt])
}

model EagleAssetOperationItem {
  id String @id
  operationId String
  ownerId String
  libraryMode LibraryMode
  ordinal Int
  assetIds String[]
  snapshots Json
  weight Int
  status String @default("PENDING")
  errorCode String?
  leaseUntil DateTime?
  leaseVersion Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  operation EagleAssetOperation @relation(fields: [ownerId, libraryMode, operationId], references: [ownerId, libraryMode, id], onDelete: Cascade, map: "EagleAssetOperationItem_scope_fkey")
  @@unique([operationId, ordinal])
  @@index([libraryMode, status, leaseUntil])
}

model User {
  assetOperations EagleAssetOperation[]
  photoAgentPreferences EaglePhotoAgentPreference[]
  photoMapStates EaglePhotoMapState[]
  libraryTransfers EagleLibraryTransfer[]
  photoPeople EaglePhotoPerson[]
  photoGroups EaglePhotoGroup[]
  id                       String                    @id @default(uuid())
  email                    String                    @unique
  passwordHash             String
  role                     UserRole                  @default(USER)
  authVersion              Int                       @default(0)
  disabledAt               DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  refreshTokens            RefreshToken[]
  personalAccessTokens     PersonalAccessToken[]
  uploadSessions           UploadSession[]
  eagleAssets              EagleAsset[]
  eaglePrivacyPreference   EaglePrivacyPreference[]
  eagleAssetAnnotations    EagleAssetAnnotation[]
  eagleManualTags          EagleManualTag[]
  eagleManualTagGroups     EagleManualTagGroup[]
  eagleAiTags              EagleAiTag[]
  eagleSmartFolders        EagleSmartFolder[]
  eagleProcessingSetting   EagleProcessingSetting[]
  eagleTaskPolicies        EagleTaskPolicy[]
  eagleUploadSessionStates EagleUploadSessionState[]
  eagleExternalLibraries   EagleExternalLibrary[]
  eagleExternalAssets      EagleExternalAsset[]
  eagleImportRuns          EagleImportRun[]
  eagleBrowserCaptures     EagleBrowserCapture[]
}

model RefreshToken {
  authVersion Int @default(0)
  familyId String @default(uuid())
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([familyId, revokedAt])
}

model EaglePrivacyPreference {
  libraryMode LibraryMode @default(MATERIAL)
  ownerId       String
  durationHours Int      @default(3)
  updatedAt     DateTime @updatedAt
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  @@id([ownerId, libraryMode])
}

model PersonalAccessToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  name       String
  scopes     String[]
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
}

model UploadSession {
  libraryMode           LibraryMode              @default(MATERIAL)
  id                    String                   @id @default(uuid())
  kind                  UploadKind               @default(EAGLE_ASSET)
  status                UploadSessionStatus      @default(INITIATED)
  originalName          String
  mimeType              String
  size                  BigInt
  objectKey             String                   @unique
  multipartUploadId     String
  completionParts       Json?
  uploaderId            String
  eagleAssetId          String?
  eagleDuplicatePolicy  String?
  objectCleanupPending  Boolean                  @default(false)
  assembledAt           DateTime?
  finalizationStartedAt DateTime?
  finalizationAttempts  Int                      @default(0)
  lastError             String?
  completedAt           DateTime?
  abortedAt             DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  uploader              User                     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  eagleAsset            EagleAsset?              @relation(fields: [uploaderId, libraryMode, eagleAssetId], references: [ownerId, libraryMode, id], onDelete: Restrict)
  eagleState            EagleUploadSessionState?
  finalizationMode      String?
  finalizationJob       UploadFinalizationJob?
  eagleBrowserCapture   EagleBrowserCapture?

  activeImportItems EagleImportRunItem[] @relation("ActiveImportUpload")

  @@unique([uploaderId, id])
  @@unique([uploaderId, libraryMode, id])
  @@index([uploaderId, libraryMode, createdAt])
  @@index([status, createdAt])
  @@index([status, updatedAt])
  @@index([objectCleanupPending, updatedAt])
  @@index([eagleAssetId])
}

model UploadFinalizationJob {
  id              String        @id @default(uuid())
  uploadSessionId String        @unique
  status          String        @default("PENDING")
  availableAt     DateTime      @default(now())
  attempts        Int           @default(0)
  leaseVersion    Int           @default(0)
  lockedAt        DateTime?
  lastError       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  uploadSession   UploadSession @relation(fields: [uploadSessionId], references: [id], onDelete: Cascade)

  @@index([status, availableAt, createdAt])
  @@index([status, lockedAt])
}

model EagleUploadSessionState {
  libraryMode           LibraryMode   @default(MATERIAL)
  uploadSessionId       String        @id
  ownerId               String
  duplicatePolicy       String        @default("SKIP")
  assetId               String?
  replacementAssetId    String?
  copySourceAssetId     String?
  copyRecipeJson        Json?
  copySourceRowVersion  Int?
  expectedContentSha256 String?
  retiredObjectKeys     String[]      @default([])
  supersededAt          DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  uploadSession         UploadSession @relation(fields: [ownerId, libraryMode, uploadSessionId], references: [uploaderId, libraryMode, id], onDelete: Cascade)
  owner                 User          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  asset                 EagleAsset?   @relation(fields: [ownerId, libraryMode, assetId], references: [ownerId, libraryMode, id], onDelete: Restrict)
  replacementAsset      EagleAsset?   @relation("EagleReplacementUpload", fields: [ownerId, libraryMode, replacementAssetId], references: [ownerId, libraryMode, id], onDelete: Restrict)

  @@unique([ownerId, uploadSessionId])
  @@unique([ownerId, libraryMode, uploadSessionId])
  @@index([ownerId, libraryMode, createdAt])
  @@index([assetId])
  @@index([ownerId, libraryMode, replacementAssetId])
}

model EagleAsset {
  libraryMode                    LibraryMode                    @default(MATERIAL)
  id                             String                         @id @default(uuid())
  ownerId                        String
  originalName                   String
  displayName                    String
  normalizedDisplayName          String
  mimeType                       String
  format                         String
  byteSize                       BigInt
  sha256                         String?
  width                          Int?
  height                         Int?
  aspectRatio                    Float?                         @default(dbgenerated())
  durationMs                     Int?
  originalObjectKey              String                         @unique
  lifecycleStatus                EagleAssetLifecycleStatus      @default(PROCESSING)
  mediaErrorCode                 String?
  mediaRevision                  Int                            @default(0)
  rowVersion                     Int                            @default(1)
  rating                         Int?
  isPrivate                      Boolean                        @default(false)
  libraryAddedAt                 DateTime                       @default(now())
  chronologicalAt                DateTime                       @default(now())
  livePhotoIdentifier            String?
  livePhotoRole                  String?
  deletedAt                      DateTime?
  transferredAt                  DateTime?
  storageTransferredOut          Boolean @default(false)
  purgeAfter                     DateTime?
  createdAt                      DateTime                       @default(now())
  updatedAt                      DateTime                       @updatedAt
  owner                          User                           @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  renditions                     EagleAssetRendition[]
  manualTagLinks                 EagleAssetManualTag[]
  manualTagIngestions            EagleAssetManualTagIngestion[]
  aiTagLinks                     EagleAssetAiTag[]
  aiAnalysisRuns                 EagleAiAnalysisRun[]
  processingJobs                 EagleAssetProcessingJob[]
  editRenderResults              EagleEditRender[]
  imagePyramids                  EagleImagePyramid[]
  colorAnalyses                  EagleAssetColorAnalysis[]
  uploadSessions                 UploadSession[]
  uploadSessionStates            EagleUploadSessionState[]
  replacementUploadSessionStates EagleUploadSessionState[]      @relation("EagleReplacementUpload")
  editRecipe                     EagleAssetEditRecipe?
  annotation                     EagleAssetAnnotation?
  externalSource                 EagleExternalAsset?
  importRunItems                 EagleImportRunItem[]
  embeddings                     EagleAssetEmbedding[]
  vectorSuggestions              EagleVectorTagSuggestion[]
  tagMemberDistances             EagleTagMemberDistance[]
  browserCaptures                EagleBrowserCapture[]
  transferFacts                  EagleAssetTransferFacts?
  photoMetadata                  EaglePhotoMetadata?
  photoLocation                  EaglePhotoLocation?
  photoAgentSuggestions          EaglePhotoAgentSuggestion[]
  photoFaces                     EaglePhotoFace[]
  bestPhotoGroups                EaglePhotoGroup[] @relation("PhotoGroupBestAsset")
  photoGroupMembers              EaglePhotoGroupMember[]

  @@unique([ownerId, id])
  @@unique([ownerId, libraryMode, id])
  @@index([ownerId, libraryMode, deletedAt, libraryAddedAt, id])
  @@index([ownerId, libraryMode, deletedAt, chronologicalAt, id])
  @@index([ownerId, libraryMode, isPrivate, deletedAt, chronologicalAt, id], map: "EagleAsset_owner_mode_privacy_chronological_idx")
  @@index([ownerId, libraryMode, livePhotoIdentifier, livePhotoRole], map: "EagleAsset_live_photo_pair_idx")
  @@index([ownerId, libraryMode, isPrivate, deletedAt, libraryAddedAt, id])
  @@index([ownerId, libraryMode, deletedAt, rating])
  @@index([ownerId, libraryMode, deletedAt, aspectRatio])
  @@index([ownerId, libraryMode, normalizedDisplayName])
  @@index([normalizedDisplayName(ops: raw("gin_trgm_ops"))], type: Gin, map: "EagleAsset_normalizedDisplayName_trgm_idx")
  @@index([originalName(ops: raw("gin_trgm_ops"))], type: Gin, map: "EagleAsset_originalName_trgm_idx")
  @@index([ownerId, libraryMode, sha256])
}

model EagleBrowserCapture {
  libraryMode      LibraryMode   @default(MATERIAL)
  id               String        @id @default(uuid())
  ownerId          String
  clientCaptureId  String
  uploadSessionId  String        @unique
  assetId          String?
  displayName      String
  pageTitle        String
  pageUrl          String
  imageUrl         String?
  altText          String?
  capturedAt       DateTime
  extensionVersion String
  completedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  owner            User          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  uploadSession    UploadSession @relation(fields: [ownerId, libraryMode, uploadSessionId], references: [uploaderId, libraryMode, id], onDelete: Cascade)
  asset            EagleAsset?   @relation(fields: [ownerId, libraryMode, assetId], references: [ownerId, libraryMode, id], onDelete: Restrict)

  @@unique([ownerId, clientCaptureId])
  @@unique([ownerId, uploadSessionId])
  @@unique([ownerId, id])
  @@unique([ownerId, libraryMode, id])
  @@unique([ownerId, libraryMode, clientCaptureId])
  @@unique([ownerId, libraryMode, uploadSessionId])
  @@index([ownerId, libraryMode, createdAt])
  @@index([ownerId, libraryMode, assetId, capturedAt])
}

model EagleAssetAnnotation {
  libraryMode LibraryMode @default(MATERIAL)
  ownerId     String
  assetId     String
  color       String?
  description String?
  sourceUrl   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  owner       User        @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  asset       EagleAsset  @relation(fields: [ownerId, libraryMode, assetId], references: [ownerId, libraryMode, id], onDelete: Cascade)

  @@id([ownerId, assetId])
  @@unique([ownerId, libraryMode, assetId])
  @@index([ownerId, libraryMode, updatedAt])
}

model EagleExternalLibrary {
  libraryMode       LibraryMode           @default(MATERIAL)
  id                String                @id @default(uuid())
  ownerId           String
  provider          EagleExternalProvider @default(EAGLE_APP)
  externalLibraryId String
  displayName       String
  sourceModifiedAt  DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  owner             User                  @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  assets            EagleExternalAsset[]
  importRuns        EagleImportRun[]

  @@unique([ownerId, libraryMode, provider, externalLibraryId])
  @@unique([ownerId, id])
  @@unique([ownerId, libraryMode, id])
  @@index([ownerId, libraryMode, updatedAt])
}

model EagleExternalAsset {
  libraryMode          LibraryMode          @default(MATERIAL)
  id                   String               @id @default(uuid())
  ownerId              String
  externalLibraryId    String
  externalItemId       String
  assetId              String?
  sourceImportedAt     DateTime?
  sourceModifiedAt     DateTime?
  metadataVersion      Int                  @default(1)
  metadataHash         String?
  sourceContentSha256  String?
  sourceFileModifiedAt DateTime?
  sourceByteSize       BigInt?
  lastSeenAt           DateTime?
  lastImportedAt       DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  owner                User                 @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  library              EagleExternalLibrary @relation(fields: [ownerId, libraryMode, externalLibraryId], references: [ownerId, libraryMode, id], onDelete: Restrict)
  /// The migration uses PostgreSQL column-specific SET NULL so ownerId remains intact.
  asset                EagleAsset?          @relation(fields: [ownerId, libraryMode, assetId], references: [ownerId, libraryMode, id], onDelete: SetNull)
  importRunItems       EagleImportRunItem[]

  @@unique([ownerId, externalLibraryId, externalItemId])
  @@unique([ownerId, assetId])
  @@unique([ownerId, id])
  @@unique([ownerId, libraryMode, id])
  @@unique([ownerId, libraryMode, externalLibraryId, externalItemId])
  @@unique([ownerId, libraryMode, assetId])
  @@index([ownerId, libraryMode, externalItemId])
}

model EagleImportRun {
  libraryMode       LibraryMode                     @default(MATERIAL)
  id                String                          @id @default(uuid())
  ownerId           String
  externalLibraryId String
  idempotencyKey    String
  declarationHash   String?
  manifestVersion   Int
  status            EagleImportRunStatus            @default(DRAFT)
  declaredItemCount Int                             @default(0)
  declaredByteSize  BigInt                          @default(0)
  stagedItemCount   Int                             @default(0)
  importedItemCount Int                             @default(0)
  skippedItemCount  Int                             @default(0)
  failedItemCount   Int                             @default(0)
  startedAt         DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  lastErrorCode     String?
  createdAt         DateTime                        @default(now())
  updatedAt         DateTime                        @updatedAt
  owner             User                            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  externalLibrary   EagleExternalLibrary            @relation(fields: [ownerId, libraryMode, externalLibraryId], references: [ownerId, libraryMode, id], onDelete: Restrict)
  manifestChunks    EagleImportManifestChunk[]
  items             EagleImportRunItem[]
  folders           EagleImportFolderDefinition[]
  tags              EagleImportTagDefinition[]
  tagGroups         EagleImportTagGroupDefinition[]

  @@unique([ownerId, libraryMode, idempotencyKey])
  @@unique([ownerId, id])
  @@unique([ownerId, libraryMode, id])
  @@index([ownerId, libraryMode, status, updatedAt])
  @@index([externalLibraryId, createdAt])
  @@index([status, completedAt])
}

model EagleImportManifestChunk {
  libraryMode       LibraryMode    @default(MATERIAL)
  id                String         @id @default(uuid())
  ownerId           String
  runId             String
  chunkKey          String
  contentHash       String
  acceptedItemCount Int
  skippedItemCount  Int
  createdAt         DateTime       @default(now())
  run               EagleImportRun @relation(fields: [ownerId, libraryMode, runId], references: [ownerId, libraryMode, id], onDelete: Cascade)

  @@unique([runId, chunkKey])
  @@index([ownerId, libraryMode, runId, createdAt])
}

model EagleImportRunItem {
  libraryMode               LibraryMode            @default(MATERIAL)
  id                        String                 @id @default(uuid())
  ownerId                   String
  runId                     String
  externalAssetId           String
  sourceItemId              String
  displayName               String
  originalFileName          String
  extension                 String
  mimeType                  String
  byteSize                  BigInt
  sourceImportedAt          DateTime?
  sourceModifiedAt          DateTime?
  rating                    Int?
  description               String?
  sourceUrl                 String?
  tagNames                  String[]               @default([])
  folderSourceIds           String[]               @default([])
  metadataHash              String
  action                    EagleImportItemAction?
  contentSha256             String?
  sourceFileModifiedAt      DateTime?
  warningCodes              String[]               @default([])
  status                    EagleImportItemStatus  @default(STAGED)
  attemptCount              Int                    @default(0)
  errorCode                 String?
  errorMessage              String?
  assetId                   String?
  activeUploadSessionId     String?                @unique
  terminalProgressAppliedAt DateTime?
  completedAt               DateTime?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  run                       EagleImportRun         @relation(fields: [ownerId, libraryMode, runId], references: [ownerId, libraryMode, id], onDelete: Cascade)
  externalAsset             EagleExternalAsset     @relation(fields: [ownerId, libraryMode, externalAssetId], references: [ownerId, libraryMode, id], onDelete: Restrict)
  /// The migration uses PostgreSQL column-specific SET NULL so ownerId remains intact.
  asset                     EagleAsset?            @relation(fields: [ownerId, libraryMode, assetId], references: [ownerId, libraryMode, id], onDelete: SetNull)

  activeUploadSession UploadSession? @relation("ActiveImportUpload", fields: [ownerId, libraryMode, activeUploadSessionId], references: [uploaderId, libraryMode, id], onDelete: SetNull)

  @@unique([runId, externalAssetId])
  @@unique([runId, sourceItemId])
  @@unique([ownerId, id])
  @@unique([ownerId, libraryMode, id])
  @@index([ownerId, libraryMode, runId, status, id])
}

model EagleImportFolderDefinition {
  libraryMode          LibraryMode    @default(MATERIAL)
  id                   String         @id @default(uuid())
  ownerId              String
  runId                String
  sourceFolderId       String
  name                 String
  parentSourceFolderId String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  run                  EagleImportRun @relation(fields: [ownerId, libraryMode, runId], references: [ownerId, libraryMode, id], onDelete: Cascade)

  @@unique([runId, sourceFolderId])
  @@index([ownerId, libraryMode, runId])
}

model EagleImportTagDefinition {
  libraryMode    LibraryMode    @default(MATERIAL)
  id             String         @id @default(uuid())
  ownerId        String
  runId          String
  name           String
  normalizedName String
  color          String?
  isStarred      Boolean        @default(false)
  groupSourceIds String[]       @default([])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  run            EagleImportRun @relation(fields: [ownerId, libraryMode, runId], references: [ownerId, libraryMode, id], onDelete: Cascade)

  @@unique([runId, normalizedName])
  @@index([ownerId, libraryMode, runId])
}

model EagleImportTagGroupDefinition {
  libraryMode    LibraryMode    @default(MATERIAL)
  id             String         @id @default(uuid())
  ownerId        String
  runId          String
  sourceGroupId  String
  name           String
  normalizedName String
  color          String?
  description    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  run            EagleImportRun @relation(fields: [ownerId, libraryMode, runId], references: [ownerId, libraryMode, id], onDelete: Cascade)

  @@unique([runId, sourceGroupId])
  @@index([ownerId, libraryMode, runId])
}

model EagleAssetRendition {
  libraryMode LibraryMode          @default(MATERIAL)
  id          String               @id @default(uuid())
  ownerId     String
  assetId     String
  kind        EagleRenditionKind
  variant     String               @default("default")
  revision    Int
  storageKey  String               @unique
  mimeType    String
  byteSize    BigInt
  width       Int?
  height      Int?
  status      EagleRenditionStatus @default(PENDING)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  asset       EagleAsset           @relation(fields: [ownerId, libraryMode, assetId], references: [ownerId, libraryMode, id], onDelete: Cascade)

  @@unique([assetId, kind, revision, variant])
  @@index([ownerId, libraryMode, assetId])
}

model EagleImagePyramid {
  libraryMode      LibraryMode             @default(MATERIAL)
  id               String                  @id @default(uuid())
  ownerId          String
  assetId          String
  revision         Int
  processorVersion String
  status           EagleImagePyramidStatus @default(PENDING)
  storagePrefix    String
  tileSize         Int                     @default(512)
  overlap          Int                     @default(1)
  format           String                  @default("webp")
  width            Int
  height           Int
  maxLevel         Int
  tileCount        Int                     @default(0)
  byteSize         BigInt                  @default(0)
  lastError        String?
  completedAt      DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  asset            EagleAsset              @relation(fields: [ownerId, libraryMode, assetId], references: [ownerId, libraryMode, id], onDelete: Cascade)

  @@unique([assetId, revision, processorVersion])
  @@unique([storagePrefix])
  @@index([ownerId, libraryMode, assetId, status])
}

model EagleManualTag {
  libraryMode        LibraryMode                           @default(MATERIAL)
  id                 String                                @id @default(uuid())
  ownerId            String
  name               String
  normalizedName     String
  color              String?
  groupId            String?
  isStarred          Boolean                               @default(false)
  marksAssetsPrivate Boolean                               @default(false)
  lastUsedAt         DateTime?
  rowVersion         Int                                   @default(1)
  createdAt          DateTime                              @default(now())
  updatedAt          DateTime                              @updatedAt
  owner              User                                  @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  group              EagleManualTagGroup?                  @relation("EagleManualTagPrimaryGroup", fields: [ownerId, libraryMode, groupId], references: [ownerId, libraryMode, id], onDelete: Restrict)
  groupMemberships   EagleManualTagGroupMembership[]
  assetLinks         EagleAssetManualTag[]
  promotedAiTagLinks EagleAssetAiTag[]                     @relation("PromotedManualTag")
  smartFolderDeps    EagleSmartFolderManualTagDependency[]
  semanticConfig     EagleManualTagSemanticConfig?
  prototypeSnapshots EagleTagPrototypeSnapshot[]
  vectorSuggestions  EagleVectorTagSuggestion[]
