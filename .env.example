NODE_ENV=development
POSTGRES_USER=sekereagle
POSTGRES_PASSWORD=replace-with-a-random-database-password
MINIO_ROOT_USER=sekereagle-local
MINIO_ROOT_PASSWORD=replace-with-a-random-minio-password
MINIO_SCANNER_SPEED=slowest
PORT=3000
SEKEREAGLE_GATEWAY_LAN_ADDRESS=
SEKEREAGLE_PUBLIC_ORIGIN=
SEKEREAGLE_ALLOW_INSECURE_PUBLIC_HTTP=false
CANONICAL_ORIGIN=http://localhost:8180
DATABASE_URL=postgresql://sekereagle:change-me@postgres:5432/sekereagle?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:8180
S3_REGION=us-east-1
S3_BUCKET=sekereagle-assets
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_CONNECTION_TIMEOUT_MS=3000
S3_REQUEST_TIMEOUT_MS=12000
S3_SOCKET_TIMEOUT_MS=10000
S3_MAX_SOCKETS=64
MLX_EMBEDDING_TOKEN=replace-with-a-separate-random-local-token
MLX_EMBEDDING_REVISION=9f2f7e710d6d81056aa5c0a4f04764fec6bb7bda
MLX_EMBEDDING_IDLE_UNLOAD_SECONDS=900
EAGLE_IMAGE_SEARCH_MINIMUM_SIMILARITY=0.25

# Import-only workers may pause optional analysis or full video transcoding.
EAGLE_BACKGROUND_PROCESSING_ENABLED=true
EAGLE_VIDEO_TRANSCODING_ENABLED=true
# Temporarily false during trusted NAS local-copy ingestion; default true.
EAGLE_UPLOAD_RECOVERY_ENABLED=true

# Optional comma-separated worker job profile; unset keeps normal scheduling.
# EAGLE_PROCESSING_JOB_KINDS=RENDER_EDITED_COPY,GENERATE_RENDITIONS,GENERATE_THUMBNAIL,GENERATE_PREVIEW,PROBE_MEDIA,GENERATE_EMBEDDING

# Duplicate original verification: one decoder across both modes, no selection quota.
# Protect temporary disk, native decoder memory and stalled reads respectively.
# Exceeding a budget excludes the candidate from pixel-proof cleanup; the UI shows
# an unverified count or a retryable error. See docs/performance-budget.md.
EAGLE_DUPLICATE_ORIGINAL_MAX_BYTES=536870912
EAGLE_DUPLICATE_ORIGINAL_MAX_PIXELS=65000000
EAGLE_DUPLICATE_ORIGINAL_TIMEOUT_MS=120000
EAGLE_OPERATION_MEMORY_LIMIT=768m
