{
  "manifest_version": 3,
  "name": "SekerEagle 灵感采集",
  "version": "0.3.0",
  "description": "使用 Alt+右键采集网页原图、视频、动态内容和可见灵感到 SekerEagle。",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://x.com/*", "*://*.x.com/*", "*://twitter.com/*", "*://*.twitter.com/*"],
      "js": ["src/x-media-page-observer.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["src/site-media-observer.js", "src/content-script.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/capture-interaction.js",
        "src/image-source-resolver.js",
        "src/video-source-resolver.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "SekerEagle 灵感采集",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  }
}
