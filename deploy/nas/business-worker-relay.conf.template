worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 256; }
stream {
  limit_conn_zone $binary_remote_addr zone=business_worker:64k;
  limit_conn business_worker 64;
  ssl_protocols TLSv1.3;
  ssl_certificate /etc/sekereagle-worker-relay/tls/server.pem;
  ssl_certificate_key /etc/sekereagle-worker-relay/tls/server.key;
  ssl_client_certificate /etc/sekereagle-worker-relay/tls/ca.pem;
  ssl_verify_client on;
  ssl_verify_depth 1;
  ssl_handshake_timeout 5s;
  ssl_session_cache shared:worker_tls:1m;
  ssl_session_timeout 10m;
  resolver 127.0.0.11 valid=10s ipv6=off;
  resolver_timeout 2s;
  proxy_connect_timeout 5s;
  proxy_timeout 1200s;
  proxy_socket_keepalive on;
  # Docker publishing may hide the peer behind its bridge gateway.
  # The dedicated Mac client certificate, not this observable source, is identity.
  allow __MAC_WORKER_IPV4__;
  allow __DOCKER_PUBLISHED_PROXY_IPV4__;
  deny all;
  server { listen 22432 ssl; set $database_backend postgres:5432; proxy_pass $database_backend; }
  server { listen 22000 ssl; set $objects_backend minio:9000; proxy_pass $objects_backend; }
  server { listen 22436 ssl; proxy_pass 127.0.0.1:24436; }
}

http {
  client_body_temp_path /tmp/client_temp;
  proxy_temp_path /tmp/proxy_temp;
  fastcgi_temp_path /tmp/fastcgi_temp;
  uwsgi_temp_path /tmp/uwsgi_temp;
  scgi_temp_path /tmp/scgi_temp;
  access_log off;
  resolver 127.0.0.11 valid=10s ipv6=off;
  resolver_timeout 2s;
  server {
    listen 127.0.0.1:24436;
    allow 127.0.0.1;
    deny all;
    client_max_body_size 0;
    client_body_timeout 1200s;
    proxy_http_version 1.1;
    proxy_set_header Host compute-coordinator;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 1200s;
    proxy_send_timeout 1200s;
    proxy_request_buffering off;
    proxy_buffering off;
    set $execution_backend compute-coordinator:11436;
    location = /healthz {
      limit_except GET { deny all; }
      proxy_pass http://$execution_backend;
    }
    location ~ ^/v1/(embeddings/(image|text)|media/(image|pyramid|video|faces))$ {
      limit_except POST { deny all; }
      proxy_pass http://$execution_backend;
    }
    location / { return 404; }
  }
}
