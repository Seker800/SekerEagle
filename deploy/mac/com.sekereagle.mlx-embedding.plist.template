<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.sekereagle.mlx-embedding</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO_ROOT__/scripts/mlx-embedding-host.sh</string>
    <string>run</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO_ROOT__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>MLX_EMBEDDING_TOKEN_FILE</key><string>__REPO_ROOT__/.env</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>__REPO_ROOT__/.runtime/mlx-embedding.log</string>
  <key>StandardErrorPath</key><string>__REPO_ROOT__/.runtime/mlx-embedding.error.log</string>
</dict>
</plist>
