  "info": {
    "title": "SekerEagle API",
    "description": "",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "seker"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "writeOnly": true
          }
        },
        "required": ["username", "password"]
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "writeOnly": true
          },
          "newPassword": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "writeOnly": true
          }
        },
        "required": ["currentPassword", "newPassword"]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "new-user"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "writeOnly": true
          },
          "role": {
            "type": "string",
            "enum": ["USER", "ADMIN"],
            "default": "USER"
          }
        },
        "required": ["username", "password"]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "newPassword": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "writeOnly": true
          }
        },
        "required": ["newPassword"]
      },
      "SetUserDisabledDto": {
        "type": "object",
        "properties": {
          "disabled": {
            "type": "boolean"
          }
        },
        "required": ["disabled"]
      },
      "CreatePatDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["import:read", "asset:write"]
            }
          },
          "expiresInDays": {
            "type": "object",
            "minimum": 1,
            "maximum": 90,
            "default": 90
          }
        },
        "required": ["name", "scopes"]
      }
    }
  }
}
